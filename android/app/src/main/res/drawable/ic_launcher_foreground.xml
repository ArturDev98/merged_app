<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de Merged, en vector y no en PNG por densidad: se versiona como
     texto y no hay que regenerar cinco tamaños al tocarlo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- El área segura de un icono adaptativo es el centro: 72x72 de 108. -->
    <group android:translateX="18" android:translateY="18">
        <!-- Rama izquierda que sube y se curva hacia el tronco -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M22,58 L22,40 Q22,30 32,26 L36,24" />
        <!-- Rama derecha, simétrica -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M50,58 L50,40 Q50,30 40,26 L36,24" />
        <!-- Tronco común hacia arriba -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M36,24 L36,12" />
        <!-- Nodos de commit en cada extremo inferior -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22,52 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M50,52 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    </group>
</vector>
